jkanime_preview() {
    _slug="$(printf "%s" "$1" | cut -d ':' -f 1 | awk '{print $1}')"
    [ -z "$_slug" ] && return 0
    _page="$(anidb_curl "https://jkanime.net/${_slug}/")"
    [ -z "$_page" ] && return 0

    _title="$(clean_html "$(printf "%s" "$_page" | sed -nE 's|.*<title>([^<]+) - anime.*|\1|p' | head -n 1)")"
    _type="$(clean_html "$(printf "%s" "$_page" | sed -nE 's|.*<span>Tipo:</span> *([^<]+).*|\1|p' | head -n 1)")"
    _status="$(clean_html "$(printf "%s" "$_page" | sed -nE 's|.*<span>Estado:</span> *<div[^>]*>([^<]+).*|\1|p' | head -n 1)")"
    _yr="$(printf "%s" "$_page" | sed -nE 's|.*<span> *Emitido: *</span>.*([0-9]{4}).*|\1|p' | head -n 1)"
    [ -z "$_yr" ] && _yr="$(printf "%s" "$_page" | sed -nE 's|.*temporada/[^"]*([0-9]{4}).*|\1|p' | head -n 1)"
    _eps="$(printf "%s" "$_page" | sed -nE 's|.*<span>Episodios:</span> *([0-9]+).*|\1|p' | head -n 1)"
    if [ -z "$_eps" ] || [ "$_eps" -eq 0 ]; then
        _eps="$(printf "%s" "$_page" | sed -nE 's|.*jkanime\.net/'"${_slug}"'/([0-9]+)/.*id="uep".*|\1|p' | head -n 1)"
        [ -n "$_eps" ] && [ "$_status" = "En emision" ] && _eps="${_eps}+"
    fi
    _duration="$(clean_html "$(printf "%s" "$_page" | sed -nE 's|.*<span>Duracion:</span> *([^<]+).*|\1|p' | head -n 1)")"
    _studio="$(clean_html "$(printf "%s" "$_page" | sed -nE 's|.*studio/[^"]*">([^<]+)<.*|\1|p' | head -n 1)")"
    _langs="$(clean_html "$(printf "%s" "$_page" | sed -nE 's|.*<span>Idiomas:</span>([^<]+).*|\1|p' | head -n 1 | tr -d '\n\r' | sed 's|  *| |g')")"
    _genres="$(clean_html "$(printf "%s" "$_page" | grep -oE 'genero/[^/]+/">[^<]+' | cut -d '>' -f 2 | sort -u | tr '\n' ',' | sed 's|,$||; s|,|, |g')")"
    _synopsis="$(clean_html "$(printf "%s" "$_page" | sed -nE 's|.*<p class="scroll">([^<]+)</p>.*|\1|p' | head -n 1)")"

    _cover_dir="${XDG_CACHE_HOME:-$HOME/.cache}/ani-cli-es/covers"
    mkdir -p "$_cover_dir" 2>/dev/null || true
    _cover_file="$_cover_dir/${_slug}.jpg"
    if [ ! -f "$_cover_file" ] || [ ! -s "$_cover_file" ]; then
        curl -sL --max-time 3 "https://cdn.jkdesa.com/assets/images/animes/image/${_slug}.jpg" -o "$_cover_file" 2>/dev/null || true
    fi

    if [ "${ANI_CLI_NO_POSTER:-0}" != "1" ] && command -v chafa >/dev/null 2>&1 && [ -s "$_cover_file" ]; then
        if [ -n "$KITTY_PID" ] || [ "$TERM" = "xterm-kitty" ]; then
            chafa --format kitty --size 46x24 "$_cover_file" 2>/dev/null || true
        else
            _chafa_flags="${ANI_CLI_CHAFA_FLAGS:---format symbols --symbols sextant+quad+vhalf+block+diagonal+wedge --size 46x24 --color-space din99d --color-extractor median -w 9}"
            # shellcheck disable=SC2086
            chafa $_chafa_flags "$_cover_file" 2>/dev/null || chafa --format symbols --symbols vhalf --size 40x18 "$_cover_file" 2>/dev/null || true
        fi
        printf "${C_BLUE}◄═══════════════════════════════════════════════►${RESET}\n"
    fi

    printf "${C_PURPLE}╭─ 🍿 ANIME DECK ───────────────────────────────╮${RESET}\n"
    printf "│ \033[38;2;125;207;255m✦ ${BOLD}%s${RESET} ${DIM}(%s)${RESET}\n" "${_title:-$_slug}" "${_yr:-N/A}"
    printf "${C_BLUE}◄═══════════════════════════════════════════════►${RESET}\n"
    [ -n "$_type" ] && printf "│ ${BOLD}📌 Formato:${RESET}    [ %s ]\n" "$_type"
    [ -n "$_eps" ] && printf "│ ${BOLD}📺 Episodios:${RESET}  %s eps ${DIM}(%s)${RESET}\n" "$_eps" "${_duration:-24 min}"
    [ -n "$_status" ] && printf "│ ${BOLD}⚡ Estado:${RESET}     ${C_GREEN}● %s${RESET}\n" "$_status"
    [ -n "$_studio" ] && printf "│ ${BOLD}🎬 Estudio:${RESET}    %s\n" "$_studio"
    [ -n "$_langs" ] && printf "│ ${BOLD}🇲🇽 Idiomas:${RESET}    %s\n" "$_langs"
    [ -n "$_genres" ] && printf "│ ${BOLD}🏷️ Géneros:${RESET}    %s\n" "$(printf "%s" "$_genres" | fold -s -w 42)"
    printf "${C_PURPLE}╰───────────────────────────────────────────────╯${RESET}\n"
    if [ -n "$_synopsis" ]; then
        printf "${C_BLUE}╭─ 📝 SINOPSIS ─────────────────────────────────╮${RESET}\n"
        printf "%s\n" "$_synopsis" | fold -s -w 44 | while IFS= read -r _sline; do
            printf "│ %s\n" "$_sline"
        done
        printf "${C_BLUE}╰───────────────────────────────────────────────╯${RESET}\n"
    fi
}

jkanime_search() {
    _raw_query="$(printf "%s" "$1" | sed 's|+|_|g; s| |_|g')"
    _search_page="$(anidb_curl "https://jkanime.net/buscar/${_raw_query}/")"
    
    _tmp_dir="$(mktemp -d)"
    _res_file="$_tmp_dir/results.txt"

    printf "%s" "$_search_page" | awk '
    BEGIN { RS="<div class=\"anime__item\">"; FS="\n" }
    NR > 1 {
        slug=""; type=""; title=""
        for (i=1; i<=NF; i++) {
            if ($i ~ /href="https:\/\/jkanime.net\/[^\/]+\/"/ && slug == "") {
                match($i, /href="https:\/\/jkanime.net\/([^\/]+)\/"/, m)
                if (m[1] != "buscar" && m[1] != "directorio" && m[1] != "historial" && m[1] != "guardado" && m[1] != "estrenos" && m[1] != "top") slug = m[1]
            }
            if ($i ~ /<li class="anime">/) {
                match($i, /<li class="anime">([^<]+)<\/li>/, m)
                type = m[1]
            }
            if ($i ~ /<h5><a/) {
                match($i, /<h5><a[^>]*>([^<]+)<\/a><\/h5>/, m)
                title = m[1]
            }
        }
        if (slug != "" && title != "") {
            if (type != "") print slug "\t[" type "] " title
            else print slug "\t" title
        }
    }' | sort -u > "$_res_file"

    if [ -s "$_res_file" ]; then
        _idx=1000
        while IFS= read -r _line; do
            [ -z "$_line" ] && continue
            _idx=$((_idx + 1))
            (
                _slug="$(printf "%s" "$_line" | cut -f 1)"
                _title="$(clean_html "$(printf "%s" "$_line" | cut -f 2-)")"
                _page="$(anidb_curl "https://jkanime.net/${_slug}/")"
                _yr="$(printf "%s" "$_page" | sed -nE 's|.*<span> *Emitido: *</span>.*([0-9]{4}).*|\1|p' | head -n 1)"
                [ -z "$_yr" ] && _yr="$(printf "%s" "$_page" | sed -nE 's|.*temporada/[^"]*([0-9]{4}).*|\1|p' | head -n 1)"
                _eps="$(printf "%s" "$_page" | sed -nE 's|.*<span>Episodios:</span> *([0-9]+).*|\1|p' | head -n 1)"
                _status="$(printf "%s" "$_page" | sed -nE 's|.*<span>Estado:</span> *<div[^>]*>([^<]+).*|\1|p' | head -n 1)"
                if [ -z "$_eps" ] || [ "$_eps" -eq 0 ]; then
                    _eps="$(printf "%s" "$_page" | sed -nE 's|.*jkanime\.net/'"${_slug}"'/([0-9]+)/.*id="uep".*|\1|p' | head -n 1)"
                    [ -n "$_eps" ] && [ "$_status" = "En emision" ] && _eps="${_eps}+"
                fi
                _has_latino="$(printf "%s" "$_page" | grep -i "Latino" || true)"

                _meta=""
                [ -n "$_yr" ] && _meta="${_meta} (${_yr})"
                [ -n "$_eps" ] && _meta="${_meta} • ${_eps} eps"
                [ -n "$_has_latino" ] && _meta="${_meta} • 🇲🇽 Latino"

                printf "%s\t%s%s\n" "$_slug" "$_title" "$_meta" > "$_tmp_dir/item_$_idx"
            ) &
        done < "$_res_file"
        wait 2>/dev/null || true

        cat "$_tmp_dir"/item_* 2>/dev/null
        rm -rf "$_tmp_dir"
    else
        rm -rf "$_tmp_dir"
        _slug="$(printf "%s" "$1" | tr '[:upper:]' '[:lower:]' | tr '+' '-' | sed 's| +| |g; s| |-|g')"
        _direct_page="$(anidb_curl "https://jkanime.net/${_slug}/")"
        if ! printf "%s" "$_direct_page" | grep -q "404.png"; then
            _title="$(clean_html "$(printf "%s" "$_direct_page" | sed -nE 's|.*<title>([^<]+) - anime.*|\1|p' | head -n 1)")"
            _type="$(clean_html "$(printf "%s" "$_direct_page" | sed -nE 's|.*<span>Tipo:</span> *([^<]+).*|\1|p' | head -n 1)")"
            _yr="$(printf "%s" "$_direct_page" | sed -nE 's|.*<span> *Emitido: *</span>.*([0-9]{4}).*|\1|p' | head -n 1)"
            _eps="$(printf "%s" "$_direct_page" | sed -nE 's|.*<span>Episodios:</span> *([0-9]+).*|\1|p' | head -n 1)"
            _status="$(printf "%s" "$_direct_page" | sed -nE 's|.*<span>Estado:</span> *<div[^>]*>([^<]+).*|\1|p' | head -n 1)"
            if [ -z "$_eps" ] || [ "$_eps" -eq 0 ]; then
                _eps="$(printf "%s" "$_direct_page" | sed -nE 's|.*jkanime\.net/'"${_slug}"'/([0-9]+)/.*id="uep".*|\1|p' | head -n 1)"
                [ -n "$_eps" ] && [ "$_status" = "En emision" ] && _eps="${_eps}+"
            fi
            _has_latino="$(printf "%s" "$_direct_page" | grep -i "Latino" || true)"
            [ -z "$_title" ] && _title="$_slug"
            [ -n "$_type" ] && _title="[${_type}] ${_title}"
            [ -n "$_yr" ] && _title="${_title} (${_yr})"
            [ -n "$_eps" ] && _title="${_title} • ${_eps} eps"
            [ -n "$_has_latino" ] && _title="${_title} • 🇲🇽 Latino"
            printf "%s\t%s\n" "$_slug" "$_title"
        fi
    fi
}

jkanime_estrenos() {
    start_spinner "Obteniendo cartelera de estrenos..."
    _page="$(anidb_curl "https://jkanime.net/")"
    stop_spinner
    [ -z "$_page" ] && die "No se pudo conectar con JKAnime"

    printf "%s" "$_page" | awk '
    BEGIN { RS="<div class=\"mb-4 d-flex align-items-stretch mb-3 dir1\">" }
    NR > 1 {
        slug=""; ep=""; day=""; title=""
        if (match($0, /href="https:\/\/jkanime\.net\/([^\/]+)\/([0-9]+)\/"/, m)) {
            slug = m[1]
            ep = m[2]
        }
        if (match($0, /badge-primary">Ep ([0-9]+)</, m)) {
            if (ep == "") ep = m[1]
        }
        if (match($0, /<\/i> *([^<]+)<\/span>/, m)) {
            day = m[1]
        }
        if (match($0, /card-title">([^<]+)<\/h5>/, m)) {
            title = m[1]
        }
        if (slug != "" && ep != "") {
            if (title == "") title = slug
            if (day != "") print slug ":" ep "\t🌟 [" day "] " title " • Ep. " ep
            else print slug ":" ep "\t🌟 " title " • Ep. " ep
        }
    }' | clean_html
}

jkanime_generos() {
    _genre_menu="[01] ⚔️   ACCIÓN             ▸ Combates, peleas y adrenalina	accion
[02] 🗺️   AVENTURA           ▸ Viajes, exploración y mundos abiertos	aventura
[03] 🌀  ISEKAI             ▸ Reencarnaciones y mundos paralelos	isekai
[04] 🎭  COMEDIA            ▸ Humor, risas y parodias	comedia
[05] 🚀  CIENCIA FICCIÓN    ▸ Futuro, tecnología y espacio	sci-fi
[06] 🧙  FANTASÍA           ▸ Magia, reinos y criaturas míticas	fantasia
[07] 💖  ROMANCE            ▸ Historias de amor y drama romántico	romance
[08] 🩸  SEINEN             ▸ Historias maduras y complejas	seinen
[09] 🔥  SHOUNEN            ▸ Superación, batallas y energía juvenil	shounen
[10] 👻  SOBRENATURAL       ▸ Fantasmas, espíritus y lo oculto	sobrenatural
[11] 💀  TERROR             ▸ Horror, suspenso y escalofríos	terror
[12] 🔍  MISTERIO           ▸ Casos policiales y acertijos	misterio
[13] 🥊  ARTES MARCIALES    ▸ Técnicas de combate y artes marciales	artes-marciales
[14] 🧠  PSICOLÓGICO        ▸ Juegos mentales y thrillers	psicologico
[15] ⚽  DEPORTES           ▸ Fútbol, basket, boxeo y atletismo	deportes
[16] ✨  MAGIA              ▸ Hechizos, academias de magia	magia
[17] 🤖  MECHA              ▸ Robots gigantes y combate mecánico	mecha
[18] 👑  HISTÓRICO          ▸ Épocas antiguas y samuráis	historico
[19] 🎵  MÚSICA             ▸ Bandas, ídols y conciertos	musica
[20] 🎮  JUEGOS             ▸ Gaming, realidad virtual y torneos	juegos
[21] 🍳  GOURMET            ▸ Cocina, comida y recetas	gourmet
[22] 🏫  ESCOLAR            ▸ Vida estudiantil y academias	escolar
[23] 🌸  SLICE OF LIFE      ▸ Recuentos de la vida cotidiana	recuentos-de-la-vida"

    _chosen_genre="$(printf "%s\n" "$_genre_menu" | nth "◄═══[ EXPLORADOR DE GÉNEROS ]═══► ")"
    [ -z "$_chosen_genre" ] && return 0
    _genre_slug="$(printf "%s" "$_chosen_genre" | cut -f 2)"

    start_spinner "Cargando catálogo de $_genre_slug..."
    _page="$(anidb_curl "https://jkanime.net/genero/${_genre_slug}/")"
    
    _tmp_dir="$(mktemp -d)"
    _res_file="$_tmp_dir/results.txt"

    printf "%s" "$_page" | awk '
    BEGIN { RS="<div class=\"mb-4 d-flex align-items-stretch mb-3 dir1\">"; FS="\n" }
    NR > 1 {
        slug=""; type=""; status=""; title=""
        for (i=1; i<=NF; i++) {
            if ($i ~ /href="https:\/\/jkanime.net\/[^\/]+\/"/ && slug == "") {
                match($i, /href="https:\/\/jkanime.net\/([^\/]+)\/"/, m)
                slug = m[1]
            }
            if ($i ~ /badge-primary">/) {
                match($i, /badge-primary">([^<]+)</, m)
                if (type == "") type = m[1]
                else if (status == "") status = m[1]
            }
            if ($i ~ /card-title">/) {
                match($i, /card-title">([^<]+)<\/h5>/, m)
                title = m[1]
            }
        }
        if (slug != "" && title != "") {
            if (type != "") print slug "\t[" type "] " title
            else print slug "\t" title
        }
    }' | sort -u > "$_res_file"

    if [ -s "$_res_file" ]; then
        _idx=1000
        while IFS= read -r _line; do
            [ -z "$_line" ] && continue
            _idx=$((_idx + 1))
            (
                _s="$(printf "%s" "$_line" | cut -f 1)"
                _t="$(clean_html "$(printf "%s" "$_line" | cut -f 2-)")"
                _p="$(anidb_curl "https://jkanime.net/${_s}/")"
                _yr="$(printf "%s" "$_p" | sed -nE "s|.*<span> *Emitido: *</span>.*([0-9]{4}).*|\1|p" | head -n 1)"
                [ -z "$_yr" ] && _yr="$(printf "%s" "$_p" | sed -nE "s|.*temporada/[^\"]*([0-9]{4}).*|\1|p" | head -n 1)"
                _eps="$(printf "%s" "$_p" | sed -nE "s|.*<span>Episodios:</span> *([0-9]+).*|\1|p" | head -n 1)"
                _st="$(printf "%s" "$_p" | sed -nE "s|.*<span>Estado:</span> *<div[^>]*>([^<]+).*|\1|p" | head -n 1)"
                if [ -z "$_eps" ] || [ "$_eps" -eq 0 ]; then
                    _eps="$(printf "%s" "$_p" | sed -nE "s|.*jkanime\.net/${_s}/([0-9]+)/.*id=\"uep\".*|\1|p" | head -n 1)"
                    [ -n "$_eps" ] && [ "$_st" = "En emision" ] && _eps="${_eps}+"
                fi
                _has_latino="$(printf "%s" "$_p" | grep -i "Latino" || true)"

                _meta=""
                [ -n "$_yr" ] && _meta="${_meta} (${_yr})"
                [ -n "$_eps" ] && _meta="${_meta} • ${_eps} eps"
                [ -n "$_has_latino" ] && _meta="${_meta} • 🇲🇽 Latino"

                printf "%s\t%s%s\n" "$_s" "$_t" "$_meta" > "$_tmp_dir/item_$_idx"
            ) &
        done < "$_res_file"
        wait 2>/dev/null || true
        stop_spinner
        cat "$_tmp_dir"/item_* 2>/dev/null
        rm -rf "$_tmp_dir"
    else
        stop_spinner
        rm -rf "$_tmp_dir"
    fi
}

jkanime_episodes() {
    _slug="$1"
    _page="$(anidb_curl "https://jkanime.net/${_slug}/")"
    _token="$(printf "%s" "$_page" | sed -nE 's|.*csrf-token" content="([^"]+)".*|\1|p' | head -n 1)"
    _anime_id="$(printf "%s" "$_page" | sed -nE 's|.*data-anime="([0-9]+)".*|\1|p' | head -n 1)"
    _max_ep="$(printf "%s" "$_page" | sed -nE 's|.*<span>Episodios:</span> *([0-9]+).*|\1|p' | head -n 1)"
    if [ -z "$_max_ep" ] || [ "$_max_ep" -eq 0 ]; then
        _max_ep="$(printf "%s" "$_page" | sed -nE 's|.*jkanime\.net/'"${_slug}"'/([0-9]+)/.*id="uep".*|\1|p' | head -n 1)"
    fi
    [ -z "$_max_ep" ] && _max_ep=12

    _dates_map=""
    if [ -n "$_anime_id" ] && [ -n "$_token" ]; then
        _json="$(anidb_curl -X POST "https://jkanime.net/ajax/episodes/${_anime_id}/1" -H "X-CSRF-TOKEN: $_token" -H "X-Requested-With: XMLHttpRequest" --data-urlencode "_token=$_token")"
        _dates_map="$(printf "%s" "$_json" | grep -oE '\{"id":[^}]+\}' | sed -nE 's|.*"number":([0-9]+).*"timestamp":"([0-9]{4}-[0-9]{2}-[0-9]{2}).*|\1\t\2|p')"
    fi

    if [ "$_max_ep" -eq 1 ]; then
        _date="$(printf "%s\n" "$_dates_map" | awk '$1 == 1 {print $2}')"
        if [ -n "$_date" ]; then
            printf "1\t🎬 Película / Especial (Episodio Único)  [%s]\n" "$_date"
        else
            printf "1\t🎬 Película / Especial (Episodio Único)\n"
        fi
    else
        seq 1 "$_max_ep" | while read -r _num; do
            _date="$(printf "%s\n" "$_dates_map" | awk -v n="$_num" '$1 == n {print $2}')"
            _badge=""
            [ "$_num" -eq "$_max_ep" ] && _badge=" 🆕"
            if [ -n "$_date" ]; then
                printf "%s\t📺 Episodio %02d  [%s]%s\n" "$_num" "$_num" "$_date" "$_badge"
            else
                printf "%s\t📺 Episodio %02d%s\n" "$_num" "$_num" "$_badge"
            fi
        done
    fi
}

jkanime_m3u8() {
    _slug="$1"
    _ep_no="$2"
    _page="$(anidb_curl "https://jkanime.net/${_slug}/${_ep_no}/")"
    _embeds="$(printf "%s" "$_page" | sed -nE "s|.*video\[[0-9]+\] = '<iframe[^>]+src=\"([^\"]+)\".*|\1|p")"
    [ -z "$_embeds" ] && return 1

    printf "%s\n" "$_embeds" | while IFS= read -r _embed_url; do
        [ -z "$_embed_url" ] && continue
        _embed_page="$(anidb_curl "$_embed_url")"
        [ -z "$_embed_page" ] && continue

        # 1. HLS loadSource
        _m3u8="$(printf "%s" "$_embed_page" | sed -nE "s|.*loadSource\([[:space:]]*['\"]([^'\"]+)['\"].*|\1|p" | head -n 1)"
        [ -n "$_m3u8" ] && printf "1080p >%s\n" "$_m3u8" && continue

        # 2. Source tag
        _src="$(printf "%s" "$_embed_page" | sed -nE "s|.*<source[^>]+src=['\"]([^'\"]+)['\"].*|\1|p" | head -n 1)"
        [ -n "$_src" ] && printf "1080p >%s\n" "$_src" && continue

        # 3. Direct url parameter
        _url="$(printf "%s" "$_embed_page" | sed -nE "s|.*url:[[:space:]]*['\"]([^'\"]+)['\"].*|\1|p" | head -n 1)"
        [ -n "$_url" ] && printf "1080p >%s\n" "$_url" && continue

        # 4. File parameter
        _file="$(printf "%s" "$_embed_page" | sed -nE "s|.*file:[[:space:]]*['\"]([^'\"]+)['\"].*|\1|p" | head -n 1)"
        [ -n "$_file" ] && printf "1080p >%s\n" "$_file" && continue
    done | awk '!seen[$0]++'
}

# select the quality according to the setting
select_quality() {
    case "$1" in
        best) _result=$(printf "%s" "$links" | head -n 1) ;;
        worst) _result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4}' | tail -n 1) ;;
        *) _result=$(printf "%s" "$links" | grep -m 1 "$1") ;;
    esac
    [ -z "$_result" ] && printf "\33[2K\r\033[1;33m%s\033[0m\n" "$1 not found, defaulting to best" >&2 && _result=$(printf "%s" "$links" | head -n 1)

    video_link=$(printf "%s" "$_result" | cut -d ">" -f 2)
}

# gets embed url, collects direct links and selects one with desired quality into $episode
get_video_link() {
    start_spinner "Obteniendo enlaces de reproducción..."
    links="$(jkanime_m3u8 "$anime_id" "$ep_no")"
    stop_spinner
    [ -z "$links" ] && die "No se encontraron fuentes de reproducción para el episodio $ep_no!"
    success "Enlaces obtenidos con éxito"
    select_quality "$quality"
    [ -z "$video_link" ] && die "No se pudo resolver el enlace de vídeo!"
}

# provide countdown for the next episode release both sub and dub
time_until_next_ep() {
    animeschedule="https://animeschedule.net"
    _query="$(printf "%s" "$*" | tr ' ' '+')"
    $curl_exe -s -G "$animeschedule/api/v3/anime" --data "q=${_query}" | sed 's|},{"id"|\n|g' | while read -r _entry; do
        _route=$(printf "%s" "$_entry" | sed -nE 's|.*"route":"([^"]*)",.*|\1|p')
        _eng_title=$(printf '%s' "$_entry" | sed -nE 's|.*"english":"([^"]*)".*|\1|p')
        [ -z "$_eng_title" ] && _eng_title=$(printf '%s' "$_entry" | sed -nE 's|.*,"title":"([^"]*)".*|\1|p')
        [ -z "$_eng_title" ] && _eng_title="N/A"
        _jpn_title=$(printf '%s' "$_entry" | sed -nE 's|.*"romaji":"([^"]*)".*|\1|p')
        [ -z "$_jpn_title" ] && _jpn_title="N/A"
        _status=$(printf '%s' "$_entry" | sed -nE 's|.*"status":"([^"]*)".*|\1|p')
        [ -z "$_status" ] && _status="Unknown"

        case "$_status" in
            Ongoing) _color="33" ;;
            Finished) _color="32" ;;
            *) _color="36" ;;
        esac

        printf "Eng: %s\n" "$_eng_title"
        printf "Jpn: %s\n" "$_jpn_title"
        printf "Status: \033[1;%sm%s\033[0m\n" "$_color" "$_status"

        if [ "$_status" != "Finished" ]; then
            _page="$($curl_exe -s "$animeschedule/anime/$_route")"
            _sub_ep=$(printf "%s" "$_page" | sed -nE 's|.*release-time-type-subs"[^>]*><span class="release-time-episode-number">Episode ([0-9]+)</span>.*|\1|p' | head -n 1)
            _dub_ep=$(printf "%s" "$_page" | sed -nE 's|.*release-time-type-dub"[^>]*><span class="release-time-episode-number">Episode ([0-9]+)</span>.*|\1|p' | head -n 1)
            _sub_countdown=$(printf "%s" "$_page" | sed -nE 's|.*class="countdown-time" datetime="([^"]*)".*|\1|p' | head -n 1)
            _dub_countdown=$(printf "%s" "$_page" | sed -nE 's|.*class="countdown-time countdown-time-dub" datetime="([^"]*)".*|\1|p' | head -n 1)

            [ -n "$_sub_ep" ] && [ -n "$_sub_countdown" ] &&
                printf "Next Sub: Episode %s in \033[1;%sm%s\033[0m\n" "$_sub_ep" "$_color" "$_sub_countdown" || printf "Next Sub: N/A\n"
            [ -n "$_dub_ep" ] && [ -n "$_dub_countdown" ] &&
                printf "Next Dub: Episode %s in \033[1;%sm%s\033[0m\n" "$_dub_ep" "$_color" "$_dub_countdown" || printf "Next Dub: N/A\n"
        fi
        printf "\n"
    done
    exit 0
}

# HISTORY

migrate_history() {
    [ ! -f "$histfile" ] && return 0
    [ ! -s "$histfile" ] && return 0
    _now="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "2026-01-01 00:00:00")"
    _tmp_mig="${histfile}.mig"
    _migrated=0
    rm -f "$_tmp_mig"

    while IFS="	" read -r c1 c2 c3 c4 c5; do
        [ -z "$c1" ] && continue
        if [ -n "$c3" ] && [ -z "$c4" ]; then
            # Legacy format: ep_no \t anime_id \t anime_title
            _ep="$c1"
            _id="$c2"
            _title="$c3"
            _l="${lang:-es}"
            printf "%s\t%s\t%s\t%s\t%s\n" "$_now" "$_id" "$_ep" "$_title" "$_l" >> "$_tmp_mig"
            _migrated=1
        elif [ -n "$c4" ]; then
            # New format: timestamp \t anime_id \t ep_no \t anime_title \t lang
            _ts="$c1"
            _id="$c2"
            _ep="$c3"
            _title="$c4"
            _l="${c5:-${lang:-es}}"
            printf "%s\t%s\t%s\t%s\t%s\n" "$_ts" "$_id" "$_ep" "$_title" "$_l" >> "$_tmp_mig"
        fi
    done < "$histfile"

    if [ -s "$_tmp_mig" ]; then
        mv "$_tmp_mig" "$histfile"
    else
        rm -f "$_tmp_mig"
    fi
}

update_history() {
    [ -z "$anime_id" ] || [ -z "$ep_no" ] && return 0
    migrate_history
    _now="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "2026-01-01 00:00:00")"
    _l="${lang:-es}"
    _clean_title="$(printf "%s" "${anime_title:-$anime_id}" | tr '\t' ' ')"

    _tmp_hist="${histfile}.tmp"
    rm -f "$_tmp_hist"

    if [ -f "$histfile" ]; then
        grep -v "	${anime_id}	" "$histfile" > "$_tmp_hist" 2>/dev/null || true
    fi

    printf "%s\t%s\t%s\t%s\t%s\n" "$_now" "$anime_id" "$ep_no" "$_clean_title" "$_l" > "${histfile}.new"
    [ -f "$_tmp_hist" ] && cat "$_tmp_hist" >> "${histfile}.new"
    mv "${histfile}.new" "$histfile"
    rm -f "$_tmp_hist"
}

delete_from_history() {
    _del_id="$1"
    [ -z "$_del_id" ] || [ ! -f "$histfile" ] && return 0
    grep -v "	${_del_id}	" "$histfile" > "${histfile}.new" 2>/dev/null || true
    mv "${histfile}.new" "$histfile"
}

offline_library_tui() {
    _dl_dir="${download_dir:-.}"
    if [ ! -d "$_dl_dir" ]; then
        warn "Directorio de descargas no encontrado: $_dl_dir"
        return 1
    fi

    _files="$(find "$_dl_dir" -maxdepth 2 -type f \( -name "*.mp4" -o -name "*.mkv" -o -name "*.webm" \) 2>/dev/null | sort)"
    if [ -z "$_files" ]; then
        warn "No se encontraron episodios descargados en $_dl_dir"
        return 1
    fi

    _formatted_files="$(printf "%s\n" "$_files" | while read -r _f; do
        [ -z "$_f" ] && continue
        _bname="$(basename "$_f")"
        _sz="$(du -h "$_f" 2>/dev/null | cut -f 1)"
        printf "%s\t📁 %s  [%s]\n" "$_f" "$_bname" "$_sz"
    done)"

    while true; do
        _selected_file="$(printf "%s\n" "$_formatted_files" | nth "Biblioteca Local (Descargas Offline): ")"
        [ -z "$_selected_file" ] && return 0

        _filepath="$(printf "%s" "$_selected_file" | cut -f 1)"
        [ ! -f "$_filepath" ] && warn "Archivo no encontrado: $_filepath" && continue

        _filename="$(basename "$_filepath")"
        info "Reproduciendo offline: $_filename..."
        
        case "$player_function" in
            *mpv*) nohup $player_function $player_extra_flags --force-media-title="$_filename" "$_filepath" >/dev/null 2>&1 & ;;
            *vlc*) nohup $player_function $player_extra_flags --play-and-exit --meta-title="$_filename" "$_filepath" >/dev/null 2>&1 & ;;
            *) nohup $player_function $player_extra_flags "$_filepath" >/dev/null 2>&1 & ;;
        esac
        return 0
    done
}

history_tui() {
    migrate_history
    while true; do
        if [ ! -s "$histfile" ]; then
            warn "El historial está vacío."
            return 1
        fi

        _formatted_hist="$(while IFS="	" read -r _ts _id _ep _title _l; do
            [ -z "$_id" ] && continue
            _date_short="$(printf "%s" "$_ts" | cut -d ' ' -f 1)"
            printf "%s\t🕒 [%s] %s • Ep. %s\n" "$_id" "$_date_short" "$_title" "$_ep"
        done < "$histfile")"

        if [ -z "$_formatted_hist" ]; then
            warn "El historial está vacío."
            return 1
        fi

        _selected_id="$(printf "%s" "$_formatted_hist" | nth "Historial de reproducción: ")"
        [ -z "$_selected_id" ] && return 0

        anime_id="$(printf "%s" "$_selected_id" | cut -f 1)"
        _hist_line="$(awk -F'\t' -v id="$anime_id" '$2 == id {print; exit}' "$histfile")"
        [ -z "$_hist_line" ] && continue

        _last_ep="$(printf "%s" "$_hist_line" | cut -f 3)"
        anime_title="$(printf "%s" "$_hist_line" | cut -f 4)"
        _hist_lang="$(printf "%s" "$_hist_line" | cut -f 5)"
        [ -n "$_hist_lang" ] && lang="$_hist_lang"

        while true; do
            _action="$(printf "[1] ⏯️  CONTINUAR VIENDO           ▸ Siguiente episodio\n[2] 🔄  REPLAY / VOLVER A VER      ▸ Repetir episodio %s\n[3] 📑  SELECCIONAR EPISODIO       ▸ Elegir de la lista\n[4] ℹ️   FICHA TÉCNICA / DETALLES   ▸ Ver póster y sinopsis\n[5] 🗑️   ELIMINAR DEL HISTORIAL     ▸ Quitar de la lista\n[0] ↩️  VOLVER AL MENÚ             ▸ Regresar" "$_last_ep" | nth "◄═══[ HISTORIAL: $anime_title • Ep. $_last_ep ]═══►: ")"
            [ -z "$_action" ] && break

            case "$_action" in
                *1*|*CONTINUAR*|*Continuar*)
                    start_spinner "Cargando episodios de $anime_title..."
                    episode_maps="$(jkanime_episodes "$anime_id")"
                    jkanime_desc "$anime_id" || true
                    stop_spinner
                    [ -z "$episode_maps" ] && warn "No se pudieron obtener episodios." && continue
                    ep_list="$(printf "%s" "$episode_maps" | cut -f 1)"

                    _next_ep="$(printf "%s" "$ep_list" | sed -n "/^${_last_ep}$/{n;p;}")"
                    if [ -z "$_next_ep" ]; then
                        info "Continuando en el episodio actual ($_last_ep)..."
                        ep_no="$_last_ep"
                    else
                        ep_no="$_next_ep"
                    fi
                    play
                    interactive_loop
                    return 0
                    ;;
                *2*|*REPLAY*|*Replay*|*VOLVER*A*VER*|*Volver*a*ver*)
                    start_spinner "Cargando episodios de $anime_title..."
                    episode_maps="$(jkanime_episodes "$anime_id")"
                    jkanime_desc "$anime_id" || true
                    stop_spinner
                    [ -z "$episode_maps" ] && warn "No se pudieron obtener episodios." && continue
                    ep_list="$(printf "%s" "$episode_maps" | cut -f 1)"

                    ep_no="$_last_ep"
                    play
                    interactive_loop
                    return 0
                    ;;
                *3*|*SELECCIONAR*|*Seleccionar*)
                    start_spinner "Cargando episodios de $anime_title..."
                    episode_maps="$(jkanime_episodes "$anime_id")"
                    jkanime_desc "$anime_id" || true
                    stop_spinner
                    [ -z "$episode_maps" ] && warn "No se pudieron obtener episodios." && continue
                    ep_list="$(printf "%s" "$episode_maps" | cut -f 1)"

                    _selected_ep="$(printf "%s" "$episode_maps" | nth "Seleccionar episodio: " "$menu_multi_flag")"
                    if [ -n "$_selected_ep" ]; then
                        ep_no="$_selected_ep"
                        play
                        interactive_loop
                        return 0
                    fi
                    ;;
                *4*|*FICHA*|*Ficha*|*DETALLES*|*detalles*|*INFORMACIÓN*|*información*)
                    tput clear
                    jkanime_preview "$anime_id"
                    printf "\n\033[1;36mPresiona Enter para regresar...\033[0m" && read -r _dummy
                    ;;
                *5*|*ELIMINAR*|*Eliminar*)
                    delete_from_history "$anime_id"
                    success "Anime '$anime_title' eliminado del historial."
                    break
                    ;;
                *)
                    break
                    ;;
            esac
        done
    done
}


# PLAYING

# shellcheck disable=SC2086
# $1 = video link, $2 = video name, $3 = extra flags
download() {
    command -v "yt-dlp" >/dev/null && yt-dlp "$1" --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -o "$download_dir/$2.mp4" $3 && return 0
    ffmpeg -extension_picky 0 -loglevel error -stats -i "$1" -c copy "$download_dir/$2.mp4" $3
}

play_episode() {
    [ "$log_episode" = 1 ] && [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && command -v logger >/dev/null && logger -t ani-cli-es "${anime_title} ${ep_no}"
    [ "$skip_intro" = 1 ] && skip_flag="$(ani-skip -i "$mal_id" -e "$canon_ep_no")"
    [ -z "$video_link" ] && get_video_link
    [ -n "$lang" ] && player_extra_flags="$player_extra_flags --slang=$lang"
    # wait for the previous player to close (in range selection)
    wait
    # shellcheck disable=SC2086
    case "$player_function" in
        debug) printf "All links:\n%s\nSelected link:\n%s\n" "$links" "$video_link" ;;
        android_mpv) nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" -n is.xyz.mpv/.MPVActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 & ;;
        android_vlc) nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 & ;;
        *flatpak*mpv*) flatpak run io.mpv.Mpv $skip_flag $player_extra_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 & ;;
        *mpv*)
            if [ "$no_detach" = 0 ]; then
                nohup $player_function $skip_flag $player_extra_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            else
                $player_function $skip_flag $player_extra_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link"
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$_range" ] && exit "$mpv_exitcode"
            fi
            ;;
        *iina*)
            if pgrep -f "IINA" >/dev/null 2>&1; then
                # omit --keep-running when an IINA instance exists to prevent hanging
                nohup $player_function $player_extra_flags --no-stdin --mpv-force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            else
                nohup $player_function $player_extra_flags --no-stdin --keep-running --mpv-force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            fi
            ;;
        *vlc*) nohup $player_function $player_extra_flags --play-and-exit --meta-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 & ;;
        *yncpla*) nohup $player_function $player_extra_flags "$video_link" -- --force-media-title="${anime_title} Episode ${ep_no}" >/dev/null 2>&1 & ;;
        download) "$player_function" "$video_link" "${anime_title} Episode ${ep_no}" $player_extra_flags ;;
        catt) nohup catt cast $player_extra_flags "$video_link" >/dev/null 2>&1 & ;;
        iSH)
            printf "\033]8;;vlc://%s\a~~~~~~~~~~~~~~~~~~~~\n~ Tap to open VLC ~\n~~~~~~~~~~~~~~~~~~~~\033]8;;\a\n" "$video_link"
            sleep 5
            ;;
        *) nohup $player_function $player_extra_flags "$video_link" >/dev/null 2>&1 & ;;
    esac
    replay="$video_link"
    unset video_link
    update_history
    [ "$menu_program" != "fzf" ] && wait
}

play() {
    _start=$(printf "%s" "$ep_no" | grep -Eo '^(-1|[0-9]+(\.[0-9]+)?)')
    _end=$(printf "%s" "$ep_no" | grep -Eo '(-1|[0-9]+(\.[0-9]+)?)$')
    [ "$_start" = "-1" ] && ep_no=$(printf "%s" "$ep_list" | tail -n 1) && unset _start
    [ -z "$_end" ] || [ "$_end" = "$_start" ] && unset _start _end
    [ "$_end" = "-1" ] && _end=$(printf "%s" "$ep_list" | tail -n 1)
    _line_count=$(printf "%s\n" "$ep_no" | wc -l | tr -d "[:space:]")
    if [ "$_line_count" != 1 ] || [ -n "$_start" ]; then
        [ -z "$_start" ] && _start=$(printf "%s\n" "$ep_no" | head -n 1)
        [ -z "$_end" ] && _end=$(printf "%s\n" "$ep_no" | tail -n 1)
        _range=$(printf "%s\n" "$ep_list" | sed -nE "/^${_start}\$/,/^${_end}\$/p")
        [ -z "$_range" ] && die "Invalid range!"
        for i in $_range; do
            tput clear
            ep_no=$i
            canon_ep_no="$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/=")"
            info "Playing episode $ep_no..."
            [ "$i" = "$_end" ] && unset _range
            play_episode
        done
    else
        printf "%s" "$ep_list" | grep -q "^$ep_no$" || die "Invalid episode!"
        canon_ep_no="$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/=")"
        play_episode
    fi
    # moves up to stored position and deletes to end
    [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && tput rc && tput ed
}

interactive_loop() {
    [ "$player_function" = "download" ] || [ "$player_function" = "debug" ] && return 0
    # shellcheck disable=SC2059
    while cmd=$(printf "[N] ⏭️  SIGUIENTE EPISODIO       ▸ Avanzar al siguiente\n[R] 🔄  REPETIR EPISODIO         ▸ Volver a reproducir\n[P] ⏮️  EPISODIO ANTERIOR        ▸ Retroceder uno\n[E] 📑  SELECCIONAR EPISODIO     ▸ Elegir de la lista\n[B] ↩️  VOLVER A RESULTADOS      ▸ Regresar a la búsqueda\n[S] 🔍  BUSCAR OTRO ANIME        ▸ Nueva búsqueda$seasons_option\n[Q] ⚙️  CAMBIAR CALIDAD          ▸ Ajustar resolución\n[X] 🚪  SALIR                    ▸ Terminar reproducción" | nth "◄═══[ CONTROL DECK: Ep. $ep_no • $anime_title ]═══► "); do
        case "$cmd" in
            *SIGUIENTE*|*Siguiente*)
                ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null
                [ -z "$ep_no" ] && warn "No hay más episodios siguientes" && ep_no=$(printf "%s" "$ep_list" | tail -n 1)
                play
                ;;
            *Repetir*)
                video_link="$replay"
                play
                ;;
            *anterior*)
                ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{g;1!p;};h") 2>/dev/null
                [ -z "$ep_no" ] && warn "No hay episodios anteriores" && ep_no=$(printf "%s" "$ep_list" | head -n 1)
                play
                ;;
            *Seleccionar*)
                _new_ep=$(printf "%s" "$episode_maps" | nth "Seleccionar episodio: " "$menu_multi_flag")
                [ -n "$_new_ep" ] && ep_no="$_new_ep" && play
                ;;
            *temporada*|*Relacionados*)
                _selected_season=$(printf "%s" "$seasons" | nth "Seleccionar temporada / relacionado: ")
                if [ -n "$_selected_season" ]; then
                    anime_id="$(printf "%s" "$_selected_season" | cut -f 1)"
                    anime_title="$(printf "%s" "$_selected_season" | cut -f 2)"
                    start_spinner "Cargando episodios de $anime_title..."
                    episode_maps="$(jkanime_episodes "$anime_id")"
                    jkanime_desc "$anime_id" || true
                    stop_spinner
                    ep_list="$(printf '%s' "$episode_maps" | cut -f 1)"
                    ep_no="$(printf '%s' "$ep_list" | head -n 1)"
                    play
                fi
                ;;
            *resultados*)
                result=""
                anime_id=""
                ep_no=""
                _res_count="$(printf "%s\n" "$anime_list" | wc -l | tr -d "[:space:]")"
                if [ "$_res_count" -le 1 ]; then
                    query=""
                    anime_list=""
                fi
                break
                ;;
            *Buscar*)
                query=""
                anime_list=""
                result=""
                anime_id=""
                ep_no=""
                break
                ;;
            *calidad*)
                new_quality="$(printf "%s" "$links" | menu "Seleccionar calidad: " "" "$menu_extra_flags" | cut -d ">" -f 1)"
                [ -n "$new_quality" ] && select_quality "$new_quality" && play
                ;;
            *)
                cleanup
                exit 0
                ;;
        esac
    done
}

# MAIN

# setup
base_url="https://jkanime.net"

ciphers='ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305'
tls13_ciphers='TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256'
agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

mode="${ANI_CLI_MODE:-sub}"
lang="${ANI_CLI_LANG:-spa}"
download_dir="${ANI_CLI_DOWNLOAD_DIR:-.}"
log_episode="${ANI_CLI_LOG:-1}"
quality="${ANI_CLI_QUALITY:-best}"

curl_exe=$(dep_ch_failover "curl_firefox135,curl_chrome136,curl_chrome116,curl_ff117,curl") || die "Program curl not found"

case "$(uname -a | cut -d " " -f 1,3-)" in
    *Darwin*)
        cipher_flag="--ciphers $ciphers --tls13-ciphers $tls13_ciphers"
        player_function="${ANI_CLI_PLAYER:-$(dep_ch_failover "iina,/Applications/IINA.app/Contents/MacOS/iina-cli,mpv,vlc")}" || die 'No player found. Looked for iina, mpv and vlc'
        ;;                                                            # mac OS
    *ndroid*) player_function="${ANI_CLI_PLAYER:-android_mpv}" ;;     # Android OS (termux)
    *MINGW* | *WSL2*) player_function="${ANI_CLI_PLAYER:-mpv.exe}" ;; # Windows OS
    *ish*)
        player_function="${ANI_CLI_PLAYER:-iSH}"
        curl_exe=$(dep_ch_failover "curl_safari260_ios,$curl_exe")
        ;;                                                                                                                                                                                               # iOS (iSH)
    *) player_function="${ANI_CLI_PLAYER:-$(dep_ch_failover "mpv,$HOME/.local/share/flatpak/app/io.mpv.Mpv/,/var/lib/flatpak/app/io.mpv.Mpv/,vlc")}" || die 'No player found. Looked for mpv and vlc' ;; # Linux OS
esac

player_extra_flags="${ANI_CLI_PLAYER_FLAGS:-""}"
case "$player_function" in
    *mpv*)
        case "$player_extra_flags" in
            *--save-position-on-quit*) ;;
            *) player_extra_flags="$player_extra_flags --save-position-on-quit" ;;
        esac
        ;;
esac
no_detach="${ANI_CLI_NO_DETACH:-0}"
exit_after_play="${ANI_CLI_EXIT_AFTER_PLAY:-0}"
skip_intro="${ANI_CLI_SKIP_INTRO:-0}"
menu_program="${ANI_CLI_MENU:-fzf}"
menu_extra_flags="${ANI_CLI_MENU_FLAGS:-""}"

# not opening from a terminal
if [ ! -t 0 ]; then
    command -v dmenu >/dev/null && menu_program=dmenu
    command -v rofi >/dev/null && menu_program=rofi
fi

hist_dir="${ANI_CLI_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ani-cli-es}"
[ ! -d "$hist_dir" ] && mkdir -p "$hist_dir"
histfile="$hist_dir/ani-hsts"
[ ! -f "$histfile" ] && : >"$histfile"

source="${ANI_CLI_DEFAULT_SOURCE:-search}"
branch="${ANI_CLI_BRANCH:-master}"

while [ $# -gt 0 ]; do
    case "$1" in
        -v | --vlc)
            case "$(uname -a | cut -d " " -f 1,3-)" in
                *ndroid*) player_function="android_vlc" ;;
                MINGW* | *WSL2*) player_function="vlc.exe" ;;
                *ish*) player_function="iSH" ;;
                *) player_function="vlc" ;;
            esac
            ;;
        -s | --syncplay)
            case "$(uname -s)" in
                Darwin*) player_function="/Applications/Syncplay.app/Contents/MacOS/syncplay" ;;
                MINGW* | *Msys)
                    export PATH="$PATH":"/c/Program Files (x86)/Syncplay/"
                    player_function="syncplay.exe"
                    ;;
                *) player_function="syncplay" ;;
            esac
            ;;
        -q | --quality)
            [ $# -lt 2 ] && die "missing argument!"
            quality="$2"
            shift
            ;;
        -S | --select-nth)
            [ $# -lt 2 ] && die "missing argument!"
            index="$2"
            shift
            ;;
        -E | --estrenos) source=estrenos ;;
        -G | --generos) source=generos ;;
        -B | --biblioteca) source=biblioteca ;;
        -c | --continue) source=history ;;
        -d | --download)
            player_function=download
            ;;
        -D | --delete)
            : >"$histfile"
            exit 0
            ;;
        -l | --logview)
            case "$(uname -s)" in
                Darwin*) log show --predicate 'process == "logger"' ;;
                Linux*) journalctl -t ani-cli ;;
                *) die "Logger not implemented for your platform" ;;
            esac
            exit 0
            ;;
        -V | --version) version_info ;;
        -h | --help) help_info ;;
        -e | --episode | -r | --range)
            [ $# -lt 2 ] && die "missing argument!"
            ep_no="$2"
            shift
            ;;
        --preview)
            [ $# -lt 2 ] && exit 0
            jkanime_preview "$2"
            exit 0
            ;;
        --dub) mode="dub" ;;
        -L | --lang)
            [ $# -lt 2 ] && die "missing argument!"
            lang="$2"
            shift
            ;;
        --no-detach) no_detach=1 ;;
        --exit-after-play) exit_after_play=1 && no_detach=1 ;;
        --rofi) menu_program=rofi ;;
        --dmenu) menu_program=dmenu ;;
        --skip) skip_intro=1 ;;
        -N | --nextep-countdown) source=nextep ;;
        -U | --update)
            dep_ch "patch"
            branch="${2:-$branch}"
            update_script
            ;;
        *) query="$(printf "%s" "$query $1" | sed 's|^ ||;s| |+|g')" ;;
    esac
    shift
done

[ "$menu_program" = "fzf" ] && menu_multi_flag="-m"
[ "$menu_program" = "rofi" ] && menu_multi_flag="-multi-select"

info "Checking dependencies..."
dep_ch "sed"
dep_ch "grep"
[ "$skip_intro" = 1 ] && dep_ch "ani-skip"
dep_ch "$menu_program" # TODO: use dep_ch_failover to iterate through options

case "$player_function" in
    debug) ;;
    download) dep_ch_failover "yt-dlp,ffmpeg" >/dev/null || die 'Neither yt-dlp nor ffmpeg found' ;;
    android*) printf "\33[2K\rChecking of players on Android is disabled.\n" ;;
    *iSH*) printf "\33[2K\rChecking of players on iOS is disabled\n" ;;
    *flatpak*mpv*) dep_ch "flatpak" ;;
    *) dep_ch "$player_function" ;;
esac

# idk where to put this, so I put it here...
trap 'cleanup; exit 1' INT HUP TERM

# searching & main application loop
print_banner

case "$source" in
    history)
        history_tui || exit 0
        ;;
    estrenos)
        _estrenos_list="$(jkanime_estrenos)"
        if [ -n "$_estrenos_list" ]; then
            _selected="$(printf "%s\n" "$_estrenos_list" | nth "🌟 Cartelera de Estrenos: ")"
            if [ -n "$_selected" ]; then
                _selected_slug="$(printf "%s" "$_selected" | cut -f 1)"
                anime_id="$(printf "%s" "$_selected_slug" | cut -d ':' -f 1)"
                ep_no="$(printf "%s" "$_selected_slug" | cut -d ':' -f 2)"
                anime_title="$(printf "%s" "$_selected" | cut -f 2- | sed -E 's|^🌟 \[[^]]*\] *||; s| • Ep\. [0-9]+$||')"
                start_spinner "Cargando episodios de $anime_title..."
                episode_maps="$(jkanime_episodes "$anime_id")"
                jkanime_desc "$anime_id" || true
                stop_spinner
                ep_list="$(printf '%s' "$episode_maps" | cut -f 1)"
                play
                interactive_loop
            fi
        fi
        exit 0
        ;;
    generos)
        anime_list="$(jkanime_generos)"
        [ -z "$anime_list" ] && exit 0
        ;;
    biblioteca)
        offline_library_tui || exit 0
        exit 0
        ;;
    *)
        while true; do
            if [ -z "$anime_list" ]; then
                if [ -z "$query" ]; then
                    _main_choice="$(printf "[01] 🔍  BUSCAR ANIME              ▸ Explorar catálogo global\n[02] 🌟  CARTELERA DE ESTRENOS     ▸ Emisiones de hoy y semana\n[03] 🏷️   EXPLORADOR POR GÉNEROS    ▸ Shonen, Isekai, Seinen...\n[04] 🕒  HISTORIAL DE REPRODUCCIÓN ▸ Continuar donde lo dejaste\n[05] 📂  BIBLIOTECA OFFLINE        ▸ Descargas locales en disco\n[06] ⚙️   INFORMACIÓN Y AYUDA       ▸ Atajos y configuración\n[00] 🚪  SALIR                     ▸ Cerrar aplicación" | nth "◄═══[ ANIME DECK LAUNCHER ]═══►: ")"
                    case "$_main_choice" in
                        *01*|*BUSCAR*|*Buscar*|*buscar*)
                            if [ "$menu_program" = "fzf" ]; then
                                while [ -z "$query" ]; do
                                    printf "\33[2K\r\033[1;36mBuscar anime: \033[0m" && read -r query
                                done
                            else
                                query=$(: | menu "Buscar anime: " "" "$menu_extra_flags")
                                [ -z "$query" ] && continue
                            fi
                            ;;
                        *02*|*ESTRENOS*|*Estrenos*|*estrenos*)
                            _estrenos_list="$(jkanime_estrenos)"
                            if [ -n "$_estrenos_list" ]; then
                                _selected="$(printf "%s\n" "$_estrenos_list" | nth "🌟 Cartelera de Estrenos: ")"
                                if [ -n "$_selected" ]; then
                                    _selected_slug="$(printf "%s" "$_selected" | cut -f 1)"
                                    anime_id="$(printf "%s" "$_selected_slug" | cut -d ':' -f 1)"
                                    ep_no="$(printf "%s" "$_selected_slug" | cut -d ':' -f 2)"
                                    anime_title="$(printf "%s" "$_selected" | cut -f 2- | sed -E 's|^🌟 \[[^]]*\] *||; s| • Ep\. [0-9]+$||')"
                                    start_spinner "Cargando episodios de $anime_title..."
                                    episode_maps="$(jkanime_episodes "$anime_id")"
                                    jkanime_desc "$anime_id" || true
                                    stop_spinner
                                    ep_list="$(printf '%s' "$episode_maps" | cut -f 1)"
                                    play
                                    interactive_loop
                                fi
                            fi
                            continue
                            ;;
                        *03*|*GÉNEROS*|*GENEROF*|*Géneros*|*géneros*|*generos*)
                            anime_list="$(jkanime_generos)"
                            [ -z "$anime_list" ] && continue
                            query="genre_results"
                            ;;
                        *04*|*HISTORIAL*|*Historial*|*historial*)
                            history_tui
                            continue
                            ;;
                        *05*|*BIBLIOTECA*|*Biblioteca*|*biblioteca*)
                            offline_library_tui
                            continue
                            ;;
                        *06*|*INFORMACIÓN*|*INFORMACION*|*Información*|*Ayuda*|*ayuda*|*información*)
                            tput clear
                            print_banner
                            help_info
                            printf "\n\033[1;36mPresiona Enter para volver...\033[0m" && read -r _dummy
                            continue
                            ;;
                        *)
                            exit 0
                            ;;
                    esac
                fi
                # for checking new releases by specifying anime name
                [ "$source" = "nextep" ] && time_until_next_ep "$query"

                formatted_query=$(printf "%s" "$query" | sed 's| |+|g')

                start_spinner "Buscando anime..."
                anime_list=$(jkanime_search "$formatted_query")
                stop_spinner
                if [ -z "$anime_list" ]; then
                    warn "No se encontraron resultados para: $query"
                    query=""
                    continue
                fi
            fi

            if [ -z "$result" ]; then
                if [ "$index" -eq "$index" ] 2>/dev/null; then
                    result=$(printf "%s" "$anime_list" | sed -n "${index}p")
                else
                    result=$(printf "%s" "$anime_list" | nth "Seleccionar anime: ")
                fi
                if [ -z "$result" ]; then
                    query=""
                    anime_list=""
                    continue
                fi
                anime_title="$(printf "%s" "$result" | cut -f 2)"
                anime_id="$(printf "%s" "$result" | cut -f 1)"

                start_spinner "Obteniendo lista de episodios..."
                episode_maps="$(jkanime_episodes "$anime_id")"
                jkanime_desc "$anime_id" || true
                stop_spinner
                ep_list="$(printf '%s' "$episode_maps" | cut -f 1)"
            fi

            if [ -z "$ep_no" ]; then
                ep_no=$(printf "%s" "$episode_maps" | nth "Seleccionar episodio: " "$menu_multi_flag")
                if [ -z "$ep_no" ]; then
                    result=""
                    anime_id=""
                    _res_count="$(printf "%s\n" "$anime_list" | wc -l | tr -d "[:space:]")"
                    if [ "$_res_count" -le 1 ]; then
                        query=""
                        anime_list=""
                    fi
                    continue
                fi
            fi

            # moves the cursor up one line and clears that line
            tput cuu1 && tput el
            # stores the position of cursor
            tput sc

            # playback
            play
            [ "$player_function" = "download" ] || [ "$player_function" = "debug" ] && break
            interactive_loop
            [ "$player_function" = "download" ] || [ "$player_function" = "debug" ] && break
        done
        ;;
esac

