# POSIX Non-blocking Spinner
start_spinner() {
    [ -t 2 ] || return 0
    _msg="${1:-Cargando...}"
    (
        set -- "⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏"
        while true; do
            for f in "$@"; do
                printf "\r\33[2K${C_PURPLE}%s${RESET} ${C_BLUE}%s${RESET}" "$f" "$_msg" >&2
                sleep 0.08
            done
        done
    ) &
    SPINNER_PID=$!
}

stop_spinner() {
    [ -n "$SPINNER_PID" ] && kill "$SPINNER_PID" 2>/dev/null && wait "$SPINNER_PID" 2>/dev/null && unset SPINNER_PID
    printf "\r\33[2K" >&2
}

# shellcheck disable=SC2086
# $1 = prompt, $2 = multi select flag (for fzf/rofi), $3 = extra flags by user
menu() {
    case "$menu_program" in
        fzf)
            eval "fzf --layout=reverse --height=90% --border=rounded \
                --border-label=\" ◄═══[ アニメ ani-cli-es • v${version_number} ]═══► \" \
                --border-label-pos=3 \
                --prompt=\"► $1 \" \
                --pointer=\"▶ \" \
                --marker=\"★ \" \
                --header=\"◄ Esc: Salir | Tab: Marcar | Enter: Ejecutar ►\" \
                --header-first \
                --color=\"bg+:#24283b,bg:#1a1b26,spinner:#7dcfff,hl:#bb9af7\" \
                --color=\"fg:#c0caf5,header:#7aa2f7,info:#9ece6a,pointer:#bb9af7\" \
                --color=\"marker:#f7768e,prompt:#7dcfff,border:#7aa2f7,label:#bb9af7\" \
                $2 $3"
            ;;
        rofi) rofi -sort -dmenu -i -p "$1" $2 $3 ;;
        dmenu) dmenu -l 20 -p "$1" $3 ;;
        *) "$menu_program" $3 "$1" ;;
    esac
}

# provide menu. input format is either (ep_list) or (number \t anime_id \t anime_name)
nth() {
    _stdin=$(cat -)
    [ -z "$_stdin" ] && return 1
    if [ -n "$index" ]; then
        _line_count="$(printf "%s\n" "$_stdin" | wc -l | tr -d "[:space:]")"
        [ "$_line_count" -eq 1 ] && printf "%s" "$_stdin" && return 0
    fi
    _prompt="$1"
    [ $# -ne 1 ] && _multi_flag="$2"

    _cols="$(printf "%s\n" "$_stdin" | head -n 1 | awk -F'\t' '{print NF}')"
    _sample_col1="$(printf "%s\n" "$_stdin" | head -n 1 | cut -f 1)"
    _extra_flags="$menu_extra_flags"

    if [ "$_cols" -eq 2 ]; then
        if printf "%s" "$_sample_col1" | grep -qE '^[0-9]+$'; then
            _extra_flags="--delimiter='\t' --with-nth=2 $_extra_flags"
        else
            _extra_flags="--delimiter='\t' --with-nth=2 --preview='$0 --preview {1}' --preview-window=right:52%:border-rounded:wrap:sharp $_extra_flags"
        fi
    fi

    _selected=$(printf "%s" "$_stdin" | menu "$_prompt" "$_multi_flag" "$_extra_flags")
    [ -z "$_selected" ] && return 1

    if printf "%s" "$_sample_col1" | grep -qE '^[0-9]+$'; then
        printf "%s" "$_selected" | cut -f 1
    else
        printf "%s" "$_selected"
    fi
}

